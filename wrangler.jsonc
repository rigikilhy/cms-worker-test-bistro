{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms-worker-test-bistro",
  "compatibility_date": "2026-07-15",
  "pages_build_output_dir": "out",
  "vars": {
    "SITE_ID": "test-bistro-two",
    "CMS_CONTENT_PATH": "content/sites/test-bistro-two/content.json",
    "CMS_DEFAULT_LOCALE": "it",
    "CMS_LOCALES": "it,en",
    "CMS_MODULES": "restaurantInfo,openingHours,menu",
    "GITHUB_OWNER": "rigikilhy",
    "GITHUB_REPO": "cms-worker-test-bistro",
    "GITHUB_BRANCH": "main",
    "CMS_COORDINATOR_URL": "https://restaurant-cms-coordinator.tekjhsdad.workers.dev",
    "CMS_PUBLISH_LIMIT_MONTHLY": "5",
    "CMS_BODY_LIMIT_BYTES": "196608",
    "CMS_IMAGE_UPLOAD_BODY_LIMIT_BYTES": "2500000",
    "CMS_IMAGE_FILE_LIMIT_BYTES": "1500000",
    "CMS_FEATURED_IMAGE_MAX_ITEMS": "0"
  }
}
